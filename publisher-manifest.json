n-top:20px;font-size:14px;color:var(--soft)}\n\n/* ========== GUIDE ========== */\n.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}\n.step{border-left:4px solid var(--ink);padding-left:22px}\n.step .n{font-size:12px;font-weight:700;letter-spacing:.2em;color:var(--orange)}\n.step h3{margin:8px 0 12px}\n.step p{font-size:15px;color:#444}\n\n/* ========== CLIENT ========== */\n.client{border-left:4px solid var(--orange);padding:8px 0 8px 22px;max-width:720px}\n.client p{font-size:18px;line-height:1.85}\n.client .compat{margin-top:14px;font-size:14px;color:var(--soft)}\n\n/* ========== FAQ ========== */\n.faq{background:#fafafa}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px 56px}\n.faq-item{border-left:3px solid var(--line);padding-left:20px}\n.faq-item:hover{border-left-color:var(--orange)}\n.faq-item h3{font-size:17px;line-height:1.5;margin-bottom:8px}\n.faq-item p{font-size:15px;color:#444;margin:0}\n\n/* ========== FOOT NAV ========== */\n.footnav{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--ink);z-index:50}\n.footnav-inner{max-width:var(--maxw);margin:0 auto;padding:0 6vw;display:flex;justify-content:space-between;align-items:center;height:56px;font-size:14px;overflow-x:auto}\n.footnav-inner a{white-space:nowrap;padding:0 14px;letter-spacing:.08em}\n.footnav-inner a.brand{font-weight:900;color:var(--orange);padding-left:0}\n\n/* ========== RESPONSIVE ========== */\n@media (max-width:860px){.hero-foot{grid-template-columns:1fr;}\n  .hero-lede,.hero-meta{grid-column:1/-1;}\n  .manifesto-grid,.principles-grid,.guide-grid,.faq-grid{grid-template-columns:1fr;}\n  .plans-table{font-size:13px;}\n  .plans-table th,.plans-table td{padding:12px 10px;}\n  .footnav-inner{font-size:12px;}\n  .footnav-inner a{padding:0 10px;}}\n</style><main>\n\n\n<section class=\"hero\" id=\"top\">\n  <div class=\"hero-top\">\n    <span>速飞云 · SuFei Network</span>\n    <span class=\"badge\">EST. 2021</span>\n  </div>\n\n  <h1 class=\"hero-name\">速飞云(SuFei) · \n    <span class=\"cn\">速飞云</span>\n    <span class=\"en\">S U F E i</span>\n  </h1>\n\n  <div class=\"hero-foot\">\n    <p class=\"hero-lede\">\n      我们没有一句动人的广告语，只有一条被工程师反复打磨过的线路，<em>和一份关于“轻与快”的执念</em>。速飞云把网络加速这件事，做得像自来水——拧开就有，关上即静。\n    </p>\n    <div class=\"hero-meta\">\n      <b>三种套餐</b>，从个人轻量到团队专属。<br>\n      <b>一份承诺</b>，不做节点数量的数字游戏。<br>\n      <b>一个目标</b>，让网页在眨眼之间打开。\n    </div>\n  </div>\n</section>\n\n\n<section class=\"manifesto\" id=\"manifesto\">\n  <div class=\"wrap\">\n    <div class=\"h-eyebrow\">序言 / PREFACE</div>\n    <h2>我们更在意那个被忽略的指标：等待</h2>\n    <div class=\"manifesto-grid\">\n      <div>\n        <p>许多服务商在首页堆砌“极速”“稳定”“全球”，却很少有人愿意解释，那条从你的设备到目标服务器的路径上，究竟发生了什么。速飞云不是靠话术成立的品牌，它更像一群工程师把对网络的不满，写成了配置文件。</p>\n        <p>我们相信，网络加速的本质，是把不必要的跳转、拥塞和识别一层层剥掉。剩下的，才该是你真正访问的那一页。</p>\n      </div>\n      <div>\n        <p>过去三年，我们改过七版调度逻辑，换过两套核心协议，删过更多华而不实的“功能”。留下的，都是我们自己在用、也在替你承担的那部分。</p>\n        <p>这份页面没有炫目的动画，也没有夸张的承诺。如果你愿意读完，也许会发现，诚实的网络服务，其实不必大声喧哗。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"principles\">\n  <div class=\"wrap\">\n    <div class=\"h-eyebrow\">我们的坚持 / PRINCIPLES</div>\n    <h2>三条不允许被妥协的底线</h2>\n    <div class=\"principles-grid\">\n      <article class=\"principle\">\n        <div class=\"num\">01</div>\n        <h3>线路先于营销</h3>\n        <p>不靠节点数量博眼球。每一条线路在上架前都要经过延迟、丢包、晚高峰带宽的三轮实测，不合格的，宁可不开。</p>\n      </article>\n      <article class=\"principle\">\n        <div class=\"num\">02</div>\n        <h3>协议保持沉默</h3>\n        <p>我们使用自研的混淆与分流策略，让流量尽量像普通的网页浏览。不为炫技，只为让你的访问不被识别和打扰。</p>\n      </article>\n      <article class=\"principle\">\n        <div class=\"num\">03</div>\n        <h3>客服是人不是机器人</h3>\n        <p>工单由值班工程师直接处理。你的问题不会被转发给三层客服，再转回给技术。一次说清，一次解决。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"plans\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"h-eyebrow\">套餐 / PLANS</div>\n    <h2>三种额度，对应三种生活节奏</h2>\n    <p class=\"col\">没有哪个套餐是“最好的”，只有最适合你的。基础版给轻度浏览者，旗舰版给追剧和游戏玩家，团队版则是为小公司提供的、可被托管的统一出口。</p>\n\n    <table class=\"plans-table\">\n      <thead>\n        <tr>\n          <th>对比项</th>\n          <th><span class=\"pname\">基础版</span><span class=\"price\">¥15/月</span><span class=\"annual\">按年付 ¥150/年</span></th>\n          <th class=\"featured\"><span class=\"pname\">旗舰版</span><span class=\"price\">¥35/月</span><span class=\"annual\">按年付 ¥350/年</span></th>\n          <th><span class=\"pname\">团队版</span><span class=\"price\">¥85/月</span><span class=\"annual\">按年付 ¥850/年</span></th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <th>每月流量</th>\n          <td>100GB</td>\n          <td class=\"feat\">300GB</td>\n          <td>1000GB</td>\n        </tr>\n        <tr>\n          <th>同时在线设备</th>\n          <td>3 台</td>\n          <td class=\"feat\">5 台</td>\n          <td>20 台</td>\n        </tr>\n        <tr>\n          <th>流媒体解锁</th>\n          <td>基础流媒体</td>\n          <td class=\"feat\">全节点原生解锁</td>\n          <td>全节点原生解锁</td>\n        </tr>\n        <tr>\n          <th>节点池</th>\n          <td>普通线路节点池</td>\n          <td class=\"feat\">含 IPLC 专线，游戏加速优化</td>\n          <td>VIP 专属高带宽节点</td>\n        </tr>\n        <tr>\n          <th>路由定制</th>\n          <td>标准路由</td>\n          <td class=\"feat\">标准 + 游戏优化</td>\n          <td>支持企业定制路由</td>\n        </tr>\n        <tr>\n          <th>支持响应</th>\n          <td>标准工单</td>\n          <td class=\"feat\">7×24 优先工单</td>\n          <td>专属客户经理</td>\n        </tr>\n      </tbody>\n    </table>\n    <p class=\"plans-note\">套餐价格与权益以速飞云官方页面为准。本页仅作信息介绍，不构成交易要约。</p>\n  </div>\n</section>\n\n\n<section id=\"guide\">\n  <div class=\"wrap\">\n    <div class=\"h-eyebrow\">使用说明 / GUIDE</div>\n    <h2>三步，从注册到连接</h2>\n    <div class=\"guide-grid\">\n      <article class=\"step\">\n        <div class=\"n\">STEP 01</div>\n        <h3>选择套餐并完成订阅</h3>\n        <p>在速飞云官方页面选择适合你节奏的套餐，完成订阅后会收到一封包含订阅地址的邮件。那个地址就是你后续所有配置的入口。</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"n\">STEP 02</div>\n        <h3>下载客户端并导入</h3>\n        <p>根据你的设备选择对应的客户端，复制订阅地址粘贴进去。客户端会自动拉取最新的节点列表和分流规则，无需手动逐条填写。</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"n\">STEP 03</div>\n        <h3>选择节点并连接</h3>\n        <p>打开客户端的节点列表，选择一个延迟较低的节点，点击连接。此时你的网络出口已经切换，可以像往常一样浏览。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"client\">\n  <div class=\"wrap\">\n    <div class=\"h-eyebrow\">客户端 / CLIENT</div>\n    <h2>一个订阅地址，覆盖你所有的屏幕</h2>\n    <div class=\"client\">\n      <p>速飞云采用通用订阅协议，不绑定某一款特定客户端。这意味着，无论你习惯使用哪一款主流的代理工具，只需将订阅地址导入，即可同步节点列表、分流规则与更新。</p>\n      <p>我们不强制用户下载某个定制的、封装过的、甚至可能存在安全隐患的安装包。我们相信，把选择权还给用户，本身就是一种尊重。</p>\n      <p class=\"compat\">常见可用客户端包括各平台主流的代理工具。具体名称因平台而异，请以你的操作系统所支持的、来源可信的开源或官方客户端为准。</p>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"faq\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"h-eyebrow\">常见问题 / FAQ</div>\n    <h2>那些被问过很多次的问题</h2>\n    <div class=\"faq-grid\">\n      <article class=\"faq-item\">\n        <h3>三种套餐之间，真正差在哪里？</h3>\n        <p>不只是流量多少。旗舰版的核心升级在于 IPLC 专线和游戏加速优化，这对延迟敏感的场景更友好；团队版则提供定制路由和专属客户经理，适合需要统一出口的小型组织。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>我适合选基础版吗？</h3>\n        <p>如果你的日常是浏览网页、收发邮件、偶尔看一点视频，100GB 和 3 台设备足够。基础版不是“阉割版”，它面向的是真正轻度的用户。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>流媒体解锁是怎么实现的？</h3>\n        <p>通过节点出口的本地原生 IP 实现。基础版提供普通解锁，旗舰版和团队版在全节点提供原生解锁，能更好地匹配目标平台的区域识别策略。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>按年付和按月付，权益有区别吗？</h3>\n        <p>没有。按年付只是价格上的让利，对应的是同样的流量、同样的设备数、同样的节点池。我们不会用权益差异来“逼迫”你选择长周期。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>工单多久会有回复？</h3>\n        <p>标准工单通常在数小时内响应。旗舰版为 7×24 优先处理，团队版由专属客户经理对接，可即时沟通。所有工单均由值班工程师直接处理。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>能在公司里给多名同事统一使用吗？</h3>\n        <p>可以。团队版支持 20 台设备同时在线，并提供企业定制路由。如果你需要更集中的账号管理，可联系客户经理协商方案。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n</main>\n\n\n<nav class=\"footnav\">\n  <div class=\"footnav-inner\">\n    <a class=\"brand\" href=\"#top\">速飞云 SuFei</a>\n    <a href=\"#manifesto\">序言</a>\n    <a href=\"#principles\">坚持</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#guide\">使用说明</a>\n    <a href=\"#client\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>",
